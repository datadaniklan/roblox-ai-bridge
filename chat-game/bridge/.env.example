# Configure these as Render environment variables. Never put the API key in Roblox.
OPENAI_API_KEY=
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_TOKEN=
OPENAI_MODELS=gpt-6-luna,gpt-6.1-sol,gpt-6-astra
DEFAULT_MODEL=gpt-6-luna
PORT=10000
# Use 127.0.0.1 for a local Studio-only bridge. Render requires 0.0.0.0.
HOST=0.0.0.0
# Explicit offline demo only. Keep false for a real OpenAI connection.
ALLOW_MOCK=false
# Limits apply per process. Use one Render instance unless adding a shared limiter.
PLAYER_REQUESTS_PER_MINUTE=6
GLOBAL_REQUESTS_PER_MINUTE=60
METADATA_REQUESTS_PER_MINUTE=30
GLOBAL_METADATA_REQUESTS_PER_MINUTE=300
MAX_CONCURRENT_REQUESTS=8
OPENAI_TIMEOUT_MS=25000
MAX_OUTPUT_TOKENS=700
